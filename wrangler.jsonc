{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echoed-uk",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "echoed-uk-subscribers"
    }
  ]
}
